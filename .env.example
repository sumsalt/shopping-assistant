# SMTP 邮件配置（复制为 .env 后填写；.env 已被 git 忽略）
# QQ 邮箱需要先开启 SMTP 服务并使用「授权码」，不是登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sumsalt@qq.com
SMTP_PASS=
SMTP_FROM_NAME=购物助手

# 全局请求闸门间隔（毫秒），不填使用默认值
# GATE_AUTH_INTERVAL_MS=5000
# GATE_ANON_INTERVAL_MS=1000

# ===== 请求审计（异常高频告警，自发自收）=====
# 总开关，默认开启；关闭后所有 record 变空操作、不启动摘要定时器
# AUDIT_ENABLED=true
# 告警收件人；留空则自发自收（取 SMTP_USER）
# AUDIT_ALERT_TO=
# 服务器标识，写进邮件标题区分来源（如 main / test）
# AUDIT_SERVER_LABEL=main
# 统计窗口 / 告警冷却 / 日志摘要间隔（毫秒）
# AUDIT_WINDOW_MS=60000
# AUDIT_COOLDOWN_MS=600000
# AUDIT_SUMMARY_INTERVAL_MS=600000
# 只有异常才发邮件；周期流量摘要只写日志、不发邮件
# 统计性规则（突刺/全局超限）是否发告警邮件；默认 true，设 false 则退化为只记日志
# AUDIT_STAT_ALERT_ENABLED=true

# --- 确定性规则阈值（每统计窗口）---
# bypass 流请求上限：手动 / 下单 / 登录 / 其它 bypass 流
# AUDIT_BYPASS_MANUAL_LIMIT=300
# AUDIT_BYPASS_ORDER_LIMIT=40
# AUDIT_BYPASS_LOGIN_LIMIT=40
# AUDIT_BYPASS_DEFAULT_LIMIT=60
# 同一接口失败次数上限
# AUDIT_FAIL_STORM_LIMIT=30
# 单 flow 突刺：当前窗口 > 过去均值×倍数 且 > 最小样本
# AUDIT_SPIKE_FACTOR=4
# AUDIT_SPIKE_MIN_SAMPLES=50
# 全局请求数上限
# AUDIT_GLOBAL_LIMIT=3000
