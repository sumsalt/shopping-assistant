{
  "name": "shopping-assistant",
  "version": "1.0.0",
  "description": "购物助手 - 支持库存查询和到货提醒",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "web:dev": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:preview": "npm run preview -w web",
    "shared:build": "cd shared && npx tsc --project tsconfig.miniprogram.json",
    "miniprogram:build": "cd miniprogram && ./build.sh",
    "miniprogram:dev": "npm run miniprogram:build"
  },
  "keywords": [
    "shopping",
    "stock",
    "yishou"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/spark-md5": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.9",
    "axios": "^1.13.4",
    "nodemailer": "^7.0.13",
    "spark-md5": "^3.0.2"
  }
}
