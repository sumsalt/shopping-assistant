/* calculator page styles */

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
  color: #111827;
}

.textarea::placeholder {
  color: #9ca3af;
}

.textarea:focus {
  border-color: #3b82f6;
  outline: none;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 28rpx;
  color: #6b7280;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 16rpx;
}

.section-title-spaced {
  margin-top: 24rpx;
}

.btn-calculate {
  margin-top: 24rpx;
}

.input-group {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.input:focus {
  border-color: #f97316;
}

.input-hint {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-primary {
  background: #3b82f6;
  color: #fff;
}

.btn-outline {
  background: #fff;
  border: 2rpx solid #e5e7eb;
  color: #374151;
}

.btn-outline:active {
  background: #f9fafb;
}

.btn-outline.add-item {
  margin-bottom: 32rpx;
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
}

.btn:disabled {
  opacity: 0.5;
}

.divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: #e5e7eb;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.item-name-input {
  width: 160rpx;
  flex-shrink: 0;
}

.item-input {
  flex: 1;
}

.checkbox-wrapper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 6rpx;
  background: #fff;
}

.checkbox.checked {
  background: #2563eb;
  border-color: #2563eb;
  position: relative;
}

.checkbox.checked::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.checkbox-label {
  font-size: 24rpx;
  color: #4b5563;
}

.btn.btn-remove {
  width: 80rpx;
  height: 64rpx;
  padding: 0;
  flex-shrink: 0;
}

.stat-card {
  padding: 32rpx;
  border-radius: 12rpx;
  margin-top: 24rpx;
}

.stat-card.blue {
  background: #eff6ff;
  border: 2rpx solid #dbeafe;
}

.stat-card.green {
  background: #f0fdf4;
  border: 2rpx solid #dcfce7;
}

.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-label {
  font-size: 28rpx;
  color: #4b5563;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
}

.stat-value.green {
  color: #16a34a;
}

.stat-value.blue {
  color: #2563eb;
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #e5e7eb;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stat-item-label {
  font-size: 24rpx;
  color: #6b7280;
}

.stat-item-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.stat-item-value.positive {
  color: #16a34a;
}

.stat-item-value.negative {
  color: #ea580c;
}

.order-card {
  padding: 32rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
  margin-bottom: 16rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.order-index {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-index-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #dbeafe;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-index-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
}

.order-total {
  font-size: 28rpx;
  color: #4b5563;
}

.order-total-price {
  color: #16a34a;
  font-weight: 600;
}

.order-item-prices {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-item-actual-price {
  font-size: 22rpx;
  color: #9333ea;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.order-item.required {
  border-left: 4rpx solid #f97316;
}

.order-item-name {
  font-size: 26rpx;
  color: #374151;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.order-item-badge {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  background: #ffedd5;
  color: #c2410c;
  border-radius: 4rpx;
}

.order-item-price {
  font-size: 26rpx;
  font-weight: 500;
  color: #111827;
}

.order-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #e5e7eb;
  display: flex;
  justify-content: center;
}


.result-summary {
  display: grid;
  gap: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #e5e7eb;
}

.result-summary.has-unused {
  grid-template-columns: repeat(3, 1fr);
}

.result-summary.no-unused {
  grid-template-columns: repeat(2, 1fr);
}

.result-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-item-label {
  font-size: 24rpx;
  color: #6b7280;
}

.result-item-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.result-item-value.orange {
  color: #ea580c;
}

.empty-state {
  padding: 64rpx 32rpx;
  text-align: center;
}

.empty-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #f3f4f6;
  margin: 0 auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #9ca3af;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #6b7280;
  max-width: 400rpx;
  margin: 0 auto;
}

.alert-card {
  padding: 64rpx 32rpx;
  text-align: center;
  background: #fef3c7;
  border: 2rpx solid #fcd34d;
  border-radius: 16rpx;
}

.alert-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #ffedd5;
  margin: 0 auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #ea580c;
}

.alert-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.alert-desc {
  font-size: 28rpx;
  color: #6b7280;
  max-width: 400rpx;
  margin: 0 auto;
}

.hint-card {
  padding: 32rpx;
  background: #eff6ff;
  border-radius: 12rpx;
}

.hint-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e40af;
  margin-bottom: 16rpx;
}

.hint-list {
  font-size: 26rpx;
  color: #1e3a8a;
  padding-left: 32rpx;
}

.hint-list-item {
  margin-bottom: 8rpx;
}

.solution-card {
  padding: 32rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.solution-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.solution-info {
  font-size: 26rpx;
  color: #6b7280;
}

.solution-total {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

/* Modal styles */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-content {
  width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #e5e7eb;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  font-size: 40rpx;
  line-height: 48rpx;
  text-align: center;
  color: #9ca3af;
  cursor: pointer;
}

.modal-body {
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #3b82f6;
}

.form-hint {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
}
