{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "lib": ["ES2019"],
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"]
    },
    "outDir": "./",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "types": [],
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["../node_modules/@types", "./node_modules/@types"]
  },
  "include": [
    "pages/**/*.ts",
    "app.ts"
  ],
  "exclude": [
    "node_modules",
    "*.js",
    "../**/src/**",
    "../**/dist/**",
    "../**/web/**"
  ]
}
